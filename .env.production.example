# bafang-core 生产部署配置示例（compose.prod.yaml 使用）。
# 复制为 .env.production 后填入真实值；.env.production 已被 gitignore，不要提交，也不要放进镜像。
# 本文件只含占位值。值里含 $ 时用单引号包起来，避免被 Compose 当作变量展开。
# 说明见 docs/deployment.md。

# ---- 域名与证书（Caddy）----
# core 对外的域名，DNS 需指向本机，80/443 需对公网开放；国内 VPS 需完成备案。
CORE_DOMAIN=core.example.com
# ACME 账号邮箱，用于证书到期提醒。
ACME_EMAIL=ops@example.com
# 对外端口（默认 80/443，一般不改）
# HTTP_PORT=80
# HTTPS_PORT=443

# ---- core 镜像 ----
# BAFANG_CORE_IMAGE=bafang-core
# BAFANG_CORE_TAG=latest

# ---- 数据库（Compose 内的 postgres 服务；core 连接 postgres:5432）----
# 首次启动时 postgres 用这组值初始化（docker/postgres/initdb）；之后修改不会改动库里已有的密码。
# 超级用户 postgres：只用于初始化与运维（备份/恢复），不交给 core。
POSTGRES_PASSWORD=replace-with-a-strong-superuser-password
PGDATABASE=bafang
# 迁移角色（库 owner，非超级用户）：业务服务中只交给一次性 migrate 服务执行迁移，core 容器里没有它。
# 改密码会重建 postgres（短暂中断），先 ALTER ROLE 再改这里，见 docs/deployment.md 的"数据库密码轮换"。
PG_MIGRATION_USER=bafang_owner
PG_MIGRATION_PASSWORD=replace-with-a-strong-migration-password
# 运行角色（非超级用户，只有表数据权限）：core 长期运行使用。
PGUSER=bafang_app
PGPASSWORD=replace-with-a-strong-app-password
# PGSCHEMA=public

# ---- 交易确认任务（上海时间轮次，可选）----
# SETTLEMENT_ROUNDS=21:30,22:30,23:30

# ---- 发信（邮箱验证码）：生产必须配置 Resend，否则 core 启动即报错 ----
RESEND_API_KEY=re_replace_me
RESEND_FROM=八方来财 <no-reply@example.com>
# 仅临时排障：MAIL_TRANSPORT=dev-log 只把验证码打印到日志，生产不要开启。
# MAIL_TRANSPORT=

# ---- GitHub OAuth 网页登录（可选；四项都非空才启用）----
# 回调地址必须与 GitHub OAuth App 中登记的一致，并使用 CORE_DOMAIN 的 HTTPS 地址。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://core.example.com/v1/auth/github/callback
GITHUB_LOGIN_REDIRECT_URL=https://studio.example.com/

# ---- 微信小程序登录与扫码登录（可选；两项都非空才启用）----
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 扫码登录票据有效秒数（60–600）
# WECHAT_QR_TTL_SECONDS=300

# ---- 绑定码 HMAC 密钥：生产必须设置为随机高熵值，留空则绑定码能力禁用 ----
# 生成：openssl rand -base64 48
BIND_CODE_SECRET=
